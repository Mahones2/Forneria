# ==========================================
# CONFIGURACIÓN PARA PRODUCCIÓN (RENDER)
# ==========================================

# Django Secret Key - Generar uno nuevo para producción
SECRET_KEY=tu-secret-key-super-secreta-aqui

# Debug - Siempre False en producción
DEBUG=False

# Hosts permitidos - Agregar tu dominio de Render
# Ejemplo: ALLOWED_HOSTS=tu-app.onrender.com,localhost
ALLOWED_HOSTS=tu-app.onrender.com

# URL de la base de datos PostgreSQL (Railway)
# Render detecta automáticamente DATABASE_URL si conectas Railway
DATABASE_URL=postgresql://usuario:password@host:puerto/database

# URL del frontend en Vercel (opcional)
VERCEL_URL=tu-app.vercel.app

# CORS - Permitir todos los orígenes (solo si es necesario)
CORS_ALLOW_ALL=False
